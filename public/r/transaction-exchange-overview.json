{
  "$schema": "https://core-ui-kit-v2-3.vercel.app/r/schema.json",
  "name": "transaction-exchange-overview",
  "type": "registry:component",
  "title": "Transaction Exchange Overview",
  "category": "fintech",
  "dependencies": [
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/components/registry/fintech/TransactionExchangeOverview.jsx",
      "target": "components/coreui-kit/TransactionExchangeOverview.jsx",
      "type": "registry:component",
      "content": "import {\n  ArrowDownLeft,\n  ArrowUpRight,\n  ChevronRight,\n  RefreshCw,\n  TrendingDown,\n  TrendingUp,\n  WalletCards,\n} from \"lucide-react\";\n\nconst assets = [\n  { symbol: \"USD\", name: \"US Dollar\", balance: \"$12,480.32\", allocation: \"59.1%\", change: 1.84 },\n  { symbol: \"EUR\", name: \"Euro\", balance: \"€6,430.18\", allocation: \"28.4%\", change: 0.62 },\n  { symbol: \"GBP\", name: \"British Pound\", balance: \"£2,198.74\", allocation: \"12.5%\", change: -0.37 },\n];\n\nexport default function TransactionExchangeOverview() {\n  return (\n    <section className=\"relative w-full max-w-4xl overflow-hidden rounded-[30px] border border-[var(--border,rgba(255,255,255,.1))] bg-[var(--surface,#0d0d10)] p-5 shadow-[0_18px_60px_rgba(0,0,0,.24)] sm:p-6\">\n      <div aria-hidden=\"true\" className=\"absolute -right-28 -top-28 h-64 w-64 rounded-full bg-emerald-400/10 blur-[90px]\" />\n      <div aria-hidden=\"true\" className=\"absolute -bottom-32 left-1/3 h-64 w-64 rounded-full bg-sky-500/10 blur-[90px]\" />\n\n      <div className=\"relative\">\n        <div className=\"flex flex-col gap-5 border-b border-[var(--border-soft,rgba(255,255,255,.075))] pb-5 sm:flex-row sm:items-end sm:justify-between\">\n          <div>\n            <div className=\"flex items-center gap-2 text-xs font-medium text-[var(--text-muted,#64748b)]\">\n              <WalletCards className=\"h-4 w-4 text-emerald-300\" aria-hidden=\"true\" />\n              Treasury balance\n            </div>\n            <div className=\"mt-3 flex flex-wrap items-end gap-3\">\n              <p className=\"text-4xl font-semibold tracking-[-0.055em] text-white sm:text-5xl\">$21,109.24</p>\n              <div className=\"mb-1 inline-flex items-center gap-1 rounded-full border border-emerald-300/15 bg-emerald-300/[0.07] px-2.5 py-1 text-[10px] font-bold text-emerald-300\">\n                <TrendingUp className=\"h-3 w-3\" aria-hidden=\"true\" /> +3.2%\n              </div>\n            </div>\n            <p className=\"mt-2 text-[11px] text-[var(--text-subtle,#475569)]\">Across 3 settlement currencies</p>\n          </div>\n\n          <button\n            type=\"button\"\n            className=\"inline-flex items-center gap-2 self-start rounded-xl bg-white px-4 py-2.5 text-xs font-bold text-[var(--text-on-accent,#020617)] transition hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300 sm:self-auto\"\n          >\n            <RefreshCw className=\"h-3.5 w-3.5\" aria-hidden=\"true\" />\n            Exchange funds\n          </button>\n        </div>\n\n        <div className=\"grid gap-3 py-5 lg:grid-cols-[1.4fr_.6fr]\">\n          <div className=\"overflow-hidden rounded-[22px] border border-[var(--border-soft,rgba(255,255,255,.075))] bg-[var(--surface-inset,rgba(255,255,255,.025))]\">\n            <div className=\"flex items-center justify-between border-b border-[var(--border-soft,rgba(255,255,255,.075))] px-4 py-3.5\">\n              <div>\n                <p className=\"text-xs font-semibold text-[var(--text-secondary,#cbd5e1)]\">Currency positions</p>\n                <p className=\"mt-1 text-[10px] text-[var(--text-faint,#334155)]\">Live allocation and 24h movement</p>\n              </div>\n              <button\n                type=\"button\"\n                className=\"inline-flex items-center gap-1 text-[10px] font-medium text-[var(--text-subtle,#475569)] transition hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300\"\n              >\n                Details <ChevronRight className=\"h-3 w-3\" aria-hidden=\"true\" />\n              </button>\n            </div>\n\n            <div className=\"divide-y divide-white/[0.06]\">\n              {assets.map((asset, index) => {\n                const positive = asset.change >= 0;\n                const TrendIcon = positive ? TrendingUp : TrendingDown;\n                return (\n                  <div key={asset.symbol} className=\"grid grid-cols-[1fr_auto] items-center gap-4 px-4 py-4 transition hover:bg-[var(--surface-inset,rgba(255,255,255,.025))]\">\n                    <div className=\"flex min-w-0 items-center gap-3\">\n                      <div className=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[13px] border border-[var(--border,rgba(255,255,255,.1))] bg-gradient-to-br from-white/[0.07] to-white/[0.02] font-mono text-[11px] font-bold text-[var(--text-primary,#e2e8f0)]\">\n                        {asset.symbol}\n                      </div>\n                      <div className=\"min-w-0\">\n                        <p className=\"text-sm font-medium text-[var(--text-primary,#e2e8f0)]\">{asset.name}</p>\n                        <div className=\"mt-2 flex items-center gap-2\">\n                          <div aria-hidden=\"true\" className=\"h-1 w-20 overflow-hidden rounded-full bg-white/[0.05]\">\n                            <div className=\"h-full rounded-full bg-gradient-to-r from-emerald-300 to-sky-300\" style={{ width: [82, 56, 31][index] + \"%\" }} />\n                          </div>\n                          <span className=\"text-[9px] text-[var(--text-faint,#334155)]\">{asset.allocation}</span>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"text-right\">\n                      <p className=\"text-sm font-semibold text-white\">{asset.balance}</p>\n                      <p className={\"mt-1 inline-flex items-center gap-1 text-[10px] font-semibold \" + (positive ? \"text-emerald-300\" : \"text-rose-300\")}>\n                        <TrendIcon className=\"h-3 w-3\" aria-hidden=\"true\" />\n                        {positive ? \"+\" : \"\"}{asset.change.toFixed(2)}%\n                      </p>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          <div className=\"grid gap-3\">\n            <div className=\"rounded-[22px] border border-[var(--border-soft,rgba(255,255,255,.075))] bg-gradient-to-br from-emerald-300/[0.08] to-transparent p-4\">\n              <p className=\"text-[10px] font-semibold uppercase tracking-[0.15em] text-[var(--text-subtle,#475569)]\">USD / EUR</p>\n              <p className=\"mt-3 font-mono text-3xl font-semibold tracking-[-0.04em] text-white\">0.9184</p>\n              <p className=\"mt-2 inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-300\">\n                <TrendingUp className=\"h-3 w-3\" aria-hidden=\"true\" /> +0.42% today\n              </p>\n              <div aria-hidden=\"true\" className=\"mt-5 flex h-14 items-end gap-1\">\n                {[32, 45, 39, 58, 52, 71, 66, 82, 75, 91].map((height, index) => (\n                  <div key={index} className=\"flex-1 rounded-t-sm bg-gradient-to-t from-emerald-400/15 to-emerald-300/60\" style={{ height: height + \"%\" }} />\n                ))}\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div className=\"rounded-[18px] border border-[var(--border-soft,rgba(255,255,255,.075))] bg-[var(--surface-inset,rgba(255,255,255,.025))] p-3.5\">\n                <ArrowDownLeft className=\"h-4 w-4 text-emerald-300\" aria-hidden=\"true\" />\n                <p className=\"mt-4 text-[10px] text-[var(--text-subtle,#475569)]\">Incoming</p>\n                <p className=\"mt-1 text-sm font-semibold text-white\">+$4.82K</p>\n              </div>\n              <div className=\"rounded-[18px] border border-[var(--border-soft,rgba(255,255,255,.075))] bg-[var(--surface-inset,rgba(255,255,255,.025))] p-3.5\">\n                <ArrowUpRight className=\"h-4 w-4 text-rose-300\" aria-hidden=\"true\" />\n                <p className=\"mt-4 text-[10px] text-[var(--text-subtle,#475569)]\">Outgoing</p>\n                <p className=\"mt-1 text-sm font-semibold text-white\">-$2.14K</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
  ]
}