{
  "$schema": "https://core-ui-kit-v2-3.vercel.app/r/schema.json",
  "name": "upcoming-features-card",
  "type": "registry:component",
  "title": "Upcoming Features Card",
  "category": "interactive",
  "dependencies": [
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/components/registry/interactive/UpcomingFeaturesCard.jsx",
      "target": "components/coreui-kit/UpcomingFeaturesCard.jsx",
      "type": "registry:component",
      "content": "import { ArrowUpRight, Boxes, CircleDot, Sparkles, WandSparkles, Workflow } from \"lucide-react\";\n\nconst features = [\n  { title:\"Automation Studio\", description:\"Compose multi-step workflows with triggers and guardrails.\", status:\"Building\", progress:78, icon:Workflow, tone:\"from-amber-300/15 to-amber-300/[0.02]\" },\n  { title:\"Component Cloud\", description:\"Sync private component collections across every workspace.\", status:\"Planned\", progress:46, icon:Boxes, tone:\"from-rose-300/15 to-rose-300/[0.02]\" },\n  { title:\"AI Theme Lab\", description:\"Generate production design tokens from your visual language.\", status:\"Research\", progress:24, icon:WandSparkles, tone:\"from-amber-300/15 to-amber-300/[0.02]\" },\n];\n\nexport default function UpcomingFeaturesCard(){\n  return (\n    <section className=\"group relative w-full max-w-3xl overflow-hidden rounded-[30px] border border-[var(--border,rgba(255,255,255,.1))] bg-[var(--surface,#0d0d10)] p-1 shadow-[0_18px_60px_rgba(0,0,0,.24)]\">\n      <div\n        aria-hidden=\"true\"\n        className=\"absolute -left-20 -top-20 h-56 w-56 rounded-full bg-amber-400/10 blur-[80px] transition duration-700 group-hover:bg-amber-400/15\"\n      />\n      <div\n        aria-hidden=\"true\"\n        className=\"absolute -bottom-24 -right-16 h-56 w-56 rounded-full bg-rose-500/10 blur-[80px] transition duration-700 group-hover:bg-rose-500/15\"\n      />\n\n      <div className=\"relative rounded-[26px] border border-[var(--border-soft,rgba(255,255,255,.075))] bg-black/10 p-5 sm:p-6\">\n        <div className=\"flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 rounded-full border border-[var(--border,rgba(255,255,255,.1))] bg-white/[0.035] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-[var(--text-muted,#64748b)]\">\n              <Sparkles className=\"h-3.5 w-3.5 text-amber-300\" aria-hidden=\"true\" />\n              Product roadmap\n            </div>\n            <h3 className=\"mt-4 text-2xl font-semibold tracking-[-0.035em] text-white sm:text-3xl\">What we are building next.</h3>\n            <p className=\"mt-2 max-w-xl text-sm leading-6 text-[var(--text-muted,#64748b)]\">A roadmap designed to make production UI faster to discover, adapt and ship.</p>\n          </div>\n\n          <button\n            type=\"button\"\n            className=\"group/button inline-flex shrink-0 items-center gap-2 self-start rounded-xl border border-[var(--border,rgba(255,255,255,.1))] bg-white/[0.035] px-3.5 py-2.5 text-[11px] font-semibold text-[var(--text-secondary,#cbd5e1)] transition hover:-translate-y-0.5 hover:bg-white/[0.06] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300\"\n          >\n            View roadmap\n            <ArrowUpRight\n              className=\"h-3.5 w-3.5 transition group-hover/button:translate-x-0.5 group-hover/button:-translate-y-0.5\"\n              aria-hidden=\"true\"\n            />\n          </button>\n        </div>\n\n        <div className=\"mt-7 grid gap-3 md:grid-cols-3\">\n          {features.map((feature) => {\n            const Icon=feature.icon;\n            return (\n              <article key={feature.title} className=\"group/card relative overflow-hidden rounded-[22px] border border-[var(--border-soft,rgba(255,255,255,.075))] bg-[var(--surface-inset,rgba(255,255,255,.025))] p-4 transition duration-300 hover:-translate-y-1 hover:border-white/15\">\n                <div aria-hidden=\"true\" className={\"absolute inset-x-0 top-0 h-24 bg-gradient-to-b \" + feature.tone} />\n                <div className=\"relative\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex h-10 w-10 items-center justify-center rounded-[13px] border border-[var(--border,rgba(255,255,255,.1))] bg-black/20 text-[var(--text-secondary,#cbd5e1)] transition group-hover/card:scale-105 group-hover/card:text-white\">\n                      <Icon className=\"h-4.5 w-4.5\" aria-hidden=\"true\" />\n                    </div>\n                    <div className=\"inline-flex items-center gap-1.5 rounded-full border border-[var(--border-soft,rgba(255,255,255,.075))] bg-black/15 px-2.5 py-1 text-[9px] font-semibold text-[var(--text-muted,#64748b)]\">\n                      <CircleDot className=\"h-3 w-3\" aria-hidden=\"true\" />\n                      {feature.status}\n                    </div>\n                  </div>\n\n                  <h4 className=\"mt-6 text-sm font-semibold text-white\">{feature.title}</h4>\n                  <p className=\"mt-2 min-h-12 text-[11px] leading-5 text-[var(--text-subtle,#475569)]\">{feature.description}</p>\n\n                  <div className=\"mt-5\">\n                    <div className=\"flex items-center justify-between text-[9px] text-[var(--text-faint,#334155)]\">\n                      <span id={`${feature.title.replace(/\\s+/g, \"-\")}-progress-label`}>Progress</span>\n                      <span className=\"font-mono\">{feature.progress}%</span>\n                    </div>\n                    <div\n                      role=\"progressbar\"\n                      aria-labelledby={`${feature.title.replace(/\\s+/g, \"-\")}-progress-label`}\n                      aria-valuenow={feature.progress}\n                      aria-valuemin={0}\n                      aria-valuemax={100}\n                      className=\"mt-2 h-1 overflow-hidden rounded-full bg-white/[0.05]\"\n                    >\n                      <div\n                        className=\"h-full rounded-full bg-gradient-to-r from-amber-300 to-rose-300 transition-all duration-700 motion-reduce:transition-none\"\n                        style={{ width: feature.progress + \"%\" }}\n                      />\n                    </div>\n                  </div>\n                </div>\n              </article>\n            );\n          })}\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
  ]
}