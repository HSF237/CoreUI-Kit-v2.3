{
  "$schema": "https://core-ui-kit-v2-3.vercel.app/r/schema.json",
  "name": "revenue-metric-card",
  "type": "registry:component",
  "title": "Revenue Metric Card",
  "category": "fintech",
  "dependencies": [
    "lucide-react"
  ],
  "files": [
    {
      "path": "src/components/registry/fintech/RevenueMetricCard.jsx",
      "target": "components/coreui-kit/RevenueMetricCard.jsx",
      "type": "registry:component",
      "content": "import { ArrowUpRight, DollarSign, TrendingUp } from \"lucide-react\";\n\nconst points = [22, 31, 29, 44, 39, 58, 53, 69, 64, 78, 73, 88];\n\nexport default function RevenueMetricCard() {\n  return (\n    <section className=\"w-full max-w-xl rounded-[28px] border border-[var(--border,rgba(255,255,255,.1))] bg-[var(--surface,#0d0d10)] p-5 shadow-[0_18px_60px_rgba(0,0,0,.24)] sm:p-6\">\n      <div className=\"flex items-start justify-between\">\n        <div>\n          <div className=\"flex items-center gap-2 text-xs text-[var(--text-muted,#64748b)]\">\n            <DollarSign className=\"h-4 w-4 text-emerald-300\" aria-hidden=\"true\" />\n            Net revenue\n          </div>\n          <p className=\"mt-3 text-4xl font-semibold tracking-[-0.05em] text-white\">$284,920</p>\n          <div className=\"mt-2 inline-flex items-center gap-1.5 rounded-full border border-emerald-300/15 bg-emerald-300/[0.07] px-2.5 py-1 text-[11px] font-semibold text-emerald-300\">\n            <TrendingUp className=\"h-3 w-3\" aria-hidden=\"true\" />\n            12.8%\n          </div>\n        </div>\n        <button\n          type=\"button\"\n          aria-label=\"View revenue report\"\n          className=\"flex h-9 w-9 items-center justify-center rounded-xl border border-[var(--border,rgba(255,255,255,.1))] bg-white/[0.04] text-[var(--text-muted,#64748b)] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300\"\n        >\n          <ArrowUpRight className=\"h-4 w-4\" />\n        </button>\n      </div>\n      <div aria-hidden=\"true\" className=\"mt-8 flex h-36 items-end gap-2 rounded-2xl border border-[var(--border,rgba(255,255,255,.1))] bg-black/10 p-4\">\n        {points.map((p, i) => (\n          <div key={i} className=\"group relative flex h-full flex-1 items-end\">\n            <div className=\"w-full rounded-t-md bg-gradient-to-t from-emerald-400/15 to-emerald-300/70 transition group-hover:to-sky-300/80\" style={{ height: p + \"%\" }} />\n          </div>\n        ))}\n      </div>\n      <div className=\"mt-4 grid grid-cols-3 gap-2\">\n        {[[\"MRR\", \"$94.3K\"], [\"ARR\", \"$1.13M\"], [\"ARPU\", \"$86.40\"]].map(([l, v]) => (\n          <div key={l} className=\"rounded-xl border border-[var(--border,rgba(255,255,255,.1))] bg-[var(--surface-inset,rgba(255,255,255,.025))] p-3\">\n            <p className=\"text-[10px] uppercase tracking-[0.14em] text-[var(--text-faint,#334155)]\">{l}</p>\n            <p className=\"mt-1.5 text-sm font-semibold text-[var(--text-primary,#e2e8f0)]\">{v}</p>\n          </div>\n        ))}\n      </div>\n    </section>\n  );\n}\n"
    }
  ]
}